<Project Sdk="Microsoft.NET.Sdk">
  <!-- The elevated starter. The broker starts it with the Windows "runas"
       verb only at Turn on. It duplicates three pipe handles from the broker
       into the elevated engine and exits. It never reads the bearer secret
       or the pairing frame. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>HotspotShade.WinUI2.Elevate</RootNamespace>
    <AssemblyName>HotspotShade.WinUI2.Elevate</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- NativeAOT: the elevated starter has no .NET host, so no
         DOTNET_STARTUP_HOOKS, profiler, or DOTNET_ROOT value from the user
         environment can load code into it. Publishing needs the MSVC
         linker (Visual Studio "Desktop development with C++"). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HotspotShade.WinUI2.Core\HotspotShade.WinUI2.Core.csproj" />
  </ItemGroup>
</Project>
