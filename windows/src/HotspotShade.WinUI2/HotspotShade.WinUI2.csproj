<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{7A8F3D2C-4B1E-4C7A-9E2D-1F3B5C7D9A01}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>HotspotShade.WinUI2</RootNamespace>
    <AssemblyName>HotspotShade.WinUI2</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion Condition="'$(HotspotShadeSdkVersion)' == ''">10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformVersion Condition="'$(HotspotShadeSdkVersion)' != ''">$(HotspotShadeSdkVersion)</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{A5A43C5B-DE2A-4C0C-9213-0A381AF9435A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WindowsXamlEnableOverview>true</WindowsXamlEnableOverview>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <EnableDotNetNativeCompatibleProfile>true</EnableDotNetNativeCompatibleProfile>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <NoWarn>;2008</NoWarn>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <NoWarn>;2008</NoWarn>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <!-- Release builds use .NET Native, the supported UWP release toolchain.
         The owner test host activated the native build; see README.md. -->
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="MainPage.xaml.cs">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Converters\ValueConverters.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Services\BrokerConnection.cs" />
    <Compile Include="Services\ClipboardService.cs" />
    <Compile Include="Services\LocalSettingsStore.cs" />
    <Compile Include="Services\WindowHandle.cs" />
    <Compile Include="ViewModels\MainViewModel.cs" />
    <Compile Include="ViewModels\PrivacyCapabilityViewModel.cs" />
    <Compile Include="ViewModels\Rows.cs" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\SplashScreen.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Properties\Default.rd.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.15</Version>
      <!-- Use the host's installed 2.2 native runtime for the isolated preview test. -->
      <Version Condition="'$(HotspotShadeTestUwp6214)' == 'true'">6.2.14</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.UI.Xaml">
      <Version>2.8.7</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotspotShade.WinUI2.Core\HotspotShade.WinUI2.Core.csproj" />
  </ItemGroup>

  <!-- FullTrustProcessLauncher lives in the Windows Desktop Extensions for
       the UWP. The window uses it to start the packaged broker. -->
  <ItemGroup>
    <SDKReference Include="WindowsDesktop, Version=$(TargetPlatformVersion)">
      <Name>Windows Desktop Extensions for the UWP</Name>
    </SDKReference>
  </ItemGroup>

  <!-- The full-trust payload. windows/tools/stage_payload.ps1 builds it into
       windows/out/payload: Broker\ (the broker), Elevate\ (the elevated
       starter), and Engine\ (hotspotshade.exe and the official wintun.dll,
       which this repository does not bundle). The package declares
       Broker\HotspotShade.WinUI2.Broker.exe as its full-trust process. -->
  <PropertyGroup>
    <HotspotShadePayloadDir Condition="'$(HotspotShadePayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\payload\</HotspotShadePayloadDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(HotspotShadePayloadDir)Broker\**\*.*">
      <Link>Broker\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(HotspotShadePayloadDir)Elevate\**\*.*">
      <Link>Elevate\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(HotspotShadePayloadDir)Engine\hotspotshade.exe">
      <Link>Engine\hotspotshade.exe</Link>
    </Content>
    <Content Include="$(HotspotShadePayloadDir)Engine\wintun.dll" Condition="Exists('$(HotspotShadePayloadDir)Engine\wintun.dll')">
      <Link>Engine\wintun.dll</Link>
    </Content>
  </ItemGroup>
  <!-- The payload check is on by default. A compile-only build can set
       HotspotShadeSkipPayloadCheck=true to skip it. CI uses that to compile
       the app without the payload; the PC build stages and checks the
       payload. -->
  <PropertyGroup>
    <HotspotShadeSkipPayloadCheck Condition="'$(HotspotShadeSkipPayloadCheck)' == ''">false</HotspotShadeSkipPayloadCheck>
  </PropertyGroup>
  <Target Name="HotspotShadeCheckPayload" BeforeTargets="BeforeBuild" Condition="'$(HotspotShadeSkipPayloadCheck)' != 'true'">
    <Error Condition="!Exists('$(HotspotShadePayloadDir)Broker\HotspotShade.WinUI2.Broker.exe')" Text="The broker is missing from $(HotspotShadePayloadDir)Broker. Run windows\tools\stage_payload.ps1 first." />
    <Error Condition="!Exists('$(HotspotShadePayloadDir)Elevate\HotspotShade.WinUI2.Elevate.exe')" Text="The elevated starter is missing from $(HotspotShadePayloadDir)Elevate. Run windows\tools\stage_payload.ps1 first." />
    <Error Condition="!Exists('$(HotspotShadePayloadDir)Engine\hotspotshade.exe')" Text="The engine is missing from $(HotspotShadePayloadDir)Engine. Run windows\tools\stage_payload.ps1 first." />
    <Warning Condition="!Exists('$(HotspotShadePayloadDir)Engine\wintun.dll')" Text="wintun.dll is missing from $(HotspotShadePayloadDir)Engine. The app builds, but Turn on is shown as unavailable. Place the official x64 wintun.dll there to enable Turn on." />
  </Target>

  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' ">
    <VisualStudioVersion>17.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
