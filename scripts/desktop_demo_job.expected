    name: Shared desktop demo checks
    runs-on: macos-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '22'
      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2
        if: github.ref_type != 'tag'
        with:
          workspaces: desktop
      - name: Test Rust bridge and assets
        run: cargo test --locked --manifest-path desktop/Cargo.toml
      - name: Test fetch shim and page model
        run: node --test desktop/tests/fetch_shim.test.mjs desktop/tests/ui_model.test.mjs
      - name: Test browser failure report formatting
        run: node --test gui_assets/app.test.mjs
      - name: Test destination privacy reporting
        run: node --test gui_assets/destination_privacy.test.mjs
      - name: Build desktop demo
        run: cargo build --locked --manifest-path desktop/Cargo.toml
      - name: Webview smoke test (visible window, embedded assets)
        run: cargo test --locked --manifest-path desktop/Cargo.toml --features webview-smoke --test webview_smoke
      - name: Lint desktop code
        run: cargo clippy --locked --manifest-path desktop/Cargo.toml --features webview-smoke --all-targets -- -D warnings
      - name: Check desktop formatting
        run: cargo fmt --manifest-path desktop/Cargo.toml -- --check
