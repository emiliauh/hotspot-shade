    name: Assemble and checksum the release set
    needs: [verify-macos-binary, verify-ios-ipa, verify-macos-app]
    outputs:
      manifest-sha256:
        description: SHA-256 of the verified SHA256SUMS manifest
        value: ${{ steps.manifest.outputs.sha256 }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: hotspotshade-macos-arm64
          path: dist/binary
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: HotspotShade-iOS-unsigned-ipa
          path: dist/ipa
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: HotspotShade-macos-unsigned
          path: dist/app
      - name: Check the verified artifact digests
        env:
          BINARY_SHA256: ${{ needs.verify-macos-binary.outputs.sha256 }}
          IPA_SHA256: ${{ needs.verify-ios-ipa.outputs.sha256 }}
          APP_SHA256: ${{ needs.verify-macos-app.outputs.sha256 }}
        run: |
          sh scripts/release_manifest.sh --expect "$BINARY_SHA256" dist/binary/hotspotshade
          sh scripts/release_manifest.sh --expect "$IPA_SHA256" dist/ipa/HotspotShade-iOS-unsigned.ipa
          sh scripts/release_manifest.sh --expect "$APP_SHA256" dist/app/HotspotShade-unsigned.zip
      - name: Assemble the release set
        run: |
          mkdir -p release
          cp dist/binary/hotspotshade release/hotspotshade-macos-arm64.bin
          cp dist/ipa/HotspotShade-iOS-unsigned.ipa release/
          cp dist/app/HotspotShade-unsigned.zip release/
          chmod 0755 release/hotspotshade-macos-arm64.bin
      - name: Write the checksum manifest and provenance record
        run: sh scripts/release_manifest.sh release
      - name: Audit the release set
        run: sh scripts/release_audit.sh --artifacts release
      - name: Verify the checksum manifest
        run: sh scripts/release_manifest.sh --verify release
      - name: Record the verified manifest digest
        id: manifest
        run: |
          digest=$(sh scripts/release_manifest.sh --digest release/SHA256SUMS)
          echo "sha256=$digest" >> "$GITHUB_OUTPUT"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: release-bundle
          path: release/*
          retention-days: 14
