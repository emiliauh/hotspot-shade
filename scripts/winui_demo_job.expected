    name: WinUI demo model and build checks
    runs-on: windows-2025
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-dotnet@67a3573c9a986a3f9c594539f4ab511d57bb3ce9 # v4
        with:
          dotnet-version: '8.0.x'
      - name: Test WinUI demo state and source contracts
        run: dotnet run --project windows/tests/HotspotShade.WinUI2.Core.Tests/HotspotShade.WinUI2.Core.Tests.csproj --configuration Release
      - name: Test Windows service foundations (hermetic)
        run: dotnet run --project windows/tests/HotspotShade.WinUI2.ServiceHost.Tests/HotspotShade.WinUI2.ServiceHost.Tests.csproj --configuration Release
      - uses: microsoft/setup-msbuild@6fb02220983dee41ce7ae257b6f4d8f9bf5ed4ce # v2
      - name: Build WinUI demo (unsigned, no deployment)
        run: >-
          msbuild windows/HotspotShade.WinUI2.sln /restore
          /p:Configuration=Debug /p:Platform=x64
          /p:HotspotShadeSdkVersion=10.0.26100.0
          /p:GenerateAppxPackageOnBuild=false /p:AppxBundle=Never
          /p:AppxPackageSigningEnabled=false /m
